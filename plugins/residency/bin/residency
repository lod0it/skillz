#!/bin/sh
# Stable entry point: resolves its own dir through symlinks (the installer links
# this file into ~/.local/bin) and execs the real script.
self=$0
while [ -L "$self" ]; do
  dir=$(cd "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  case $self in /*) ;; *) self="$dir/$self" ;; esac
done
here=$(cd "$(dirname "$self")" && pwd)
exec python3 "$here/../lib/residency.py" "$@"
